# Copy to .env.local (never committed) and fill in. Used only on your PC by scripts/daily_audit.sh
# and python -m tracker.audit.
HYPERQWEN_DIR=/home/YOUR_WSL_USER/HyperQwen
# Same value as VLLM_API_KEY in HyperQwen's .env (leave empty if you didn't set one)
VLLM_API_KEY=
# Python with this repo's requirements (e.g. your conda env)
PYTHON=/home/YOUR_WSL_USER/miniconda3/envs/wslcode/bin/python
# Optional: Telegram "best matches" message after each review (same values as the GitHub secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=https://rutpatel4003.github.io/job-radar/
